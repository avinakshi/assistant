{
  "name": "@repo/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:integration": "vitest run test",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.0",
    "@repo/llm-router": "workspace:*",
    "@repo/ocr": "workspace:*",
    "@repo/prompts": "workspace:*",
    "@repo/question-detector": "workspace:*",
    "@repo/shared": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.12",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "ws": "^8.18.0"
  }
}
