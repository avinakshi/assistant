{
  "name": "@repo/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Interview Copilot desktop app (Electron 32, main process + renderer)",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20.0.0 <25"
  },
  "scripts": {
    "build": "pnpm run build:renderer && pnpm run build:preload && pnpm run build:main",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "node build-preload.mjs",
    "build:renderer": "vite build",
    "dev": "concurrently -n renderer,main -c green,cyan \"pnpm run dev:renderer\" \"pnpm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsx watch src/main/index.ts",
    "start": "electron dist/main/index.js",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@repo/audio-core": "workspace:*",
    "@repo/shared": "workspace:*",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "ws": "^8.18.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "esbuild": "^0.24.0",
    "electron": "^32.0.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.47",
    "rimraf": "^6.0.0",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
