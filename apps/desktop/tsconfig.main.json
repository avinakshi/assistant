{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["node"],
    "composite": true
  },
  "include": ["src/main/**/*", "src/shared/**/*"],
  "exclude": ["dist", "node_modules", "src/renderer/**", "src/preload/**"],
  "references": [{ "path": "../../packages/shared" }]
}
