<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron apps under Hardened Runtime. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key><true/>

  <!-- Audio capture: the Rust audio-core uses CoreAudio on macOS. -->
  <key>com.apple.security.device.audio-input</key><true/>

  <!-- Screen capture: Phase 5 OCR uses BitBlt on Windows and CGWindowListCreateImage
       on macOS (ships later, but the entitlement needs to be present at sign time to
       avoid a resigning round-trip). -->
  <key>com.apple.security.device.camera</key><false/>

  <!-- Network: LLM + STT egress + auto-updater downloads. -->
  <key>com.apple.security.network.client</key><true/>

  <!-- Local file access for resume uploads / crash log reads. -->
  <key>com.apple.security.files.user-selected.read-write</key><true/>
</dict>
</plist>
