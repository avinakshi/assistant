# ============================================================
# Interview Copilot — environment template
# Copy to .env (never commit). Managed via packages/shared/env.
# ============================================================

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Api (apps/api) ---
API_PORT=3001
API_HOST=0.0.0.0
WS_SHARED_SECRET=dev-shared-secret-change-me  # Phase 1 only; real JWT in Phase 6

# --- Desktop (apps/desktop) ---
DESKTOP_API_BASE_URL=http://localhost:3001
DESKTOP_API_WS_URL=ws://localhost:3001
DESKTOP_LOG_LEVEL=debug

# --- Supabase (Phase 6+) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis (Phase 4+) ---
REDIS_URL=

# --- STT (Phase 3+) ---
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# --- LLM (Phase 4+) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- OCR (Phase 5+) ---
GOOGLE_CLOUD_VISION_KEY=

# --- TTS (Phase 8+) ---
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# --- Billing (Phase 6+) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Phase 6+) ---
RESEND_API_KEY=

# --- Observability ---
SENTRY_DSN=
POSTHOG_KEY=

# --- Release signing (Phase 7+) ---
APPLE_ID=
APPLE_TEAM_ID=
APPLE_APP_SPECIFIC_PASSWORD=
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
UPDATE_MANIFEST_SIGNING_PRIVATE_KEY=
