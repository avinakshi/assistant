{
  "name": "@repo/audio-core",
  "version": "0.0.1",
  "private": true,
  "description": "Rust native addon — OS audio capture, screenshot, window enum, stealth. Windows WASAPI + macOS ScreenCaptureKit.",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "audio-core",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-pc-windows-msvc",
        "aarch64-pc-windows-msvc",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "cargo test --manifest-path=Cargo.toml",
    "lint": "cargo clippy --manifest-path=Cargo.toml -- -D warnings",
    "typecheck": "echo 'no-op (Rust crate, types generated by napi build)'",
    "clean": "rimraf target *.node"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "rimraf": "^6.0.0"
  }
}
